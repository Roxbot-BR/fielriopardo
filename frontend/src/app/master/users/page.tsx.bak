'use client';

import React, { useEffect, useState } from 'react';
import { Plus, UserCheck, UserX, Pencil, Trash2 } from 'lucide-react';
import * as DropdownMenu from '@radix-ui/react-dropdown-menu';
import { Button } from '@/components/ui/Button';
import { Badge } from '@/components/ui/Badge';
import { Modal } from '@/components/ui/Modal';
import { Input } from '@/components/ui/Input';
import { BirthDateInput } from '@/components/ui/BirthDateInput';
import { Avatar } from '@/components/ui/Avatar';
import { Spinner } from '@/components/ui/Spinner';
import api from '@/lib/api';
import { useAuth } from '@/contexts/AuthContext';
import toast from 'react-hot-toast';
import { formatDate } from '@/lib/utils';

type RoleName = 'MASTER' | 'ADMIN' | 'USER';

interface RoleObj { id: string; name: RoleName; description?: string }

interface UserRow {
  id: string;
  fullName: string;
  nick: string;
  email: string;
  whatsapp?: string;
  city?: string;
  state?: string;
  isActive: boolean;
  createdAt: string;
  avatarUrl?: string;
  roles: (RoleObj | RoleName)[];
}

const ROLES: RoleName[] = ['USER', 'ADMIN', 'MASTER'];

function getRoleName(role: RoleObj | RoleName | undefined): RoleName | undefined {
  if (!role) return undefined;
  if (typeof role === 'string') return role as RoleName;
  return role.name;
}

const roleBadge: Record<RoleName, 'gold' | 'blue' | 'gray'> = {
  MASTER: 'gold',
  ADMIN:  'blue',
  USER:   'gray',
};

const UF_LIST = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA',
  'PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];

export default function MasterUsersPage() {
  const { user: currentUser, isMaster } = useAuth();
  const [users, setUsers] = useState<UserRow[]>([]);
  const [loading, setLoading] = useState(true);

  // Create modal
  const [createOpen, setCreateOpen] = useState(false);
  const [createForm, setCreateForm] = useState({
    fullName: '', nick: '', email: '', password: '',
    whatsapp: '', city: '', state: 'SP', role: 'USER' as RoleName,
  });

  // Edit modal
  const [editOpen, setEditOpen] = useState(false);
  const [editTarget, setEditTarget] = useState<UserRow | null>(null);
  const [editForm, setEditForm] = useState({
    fullName: '', nick: '', email: '', password: '', whatsapp: '',
    city: '', state: 'SP', role: 'USER' as RoleName, isActive: true, birthDate: '',
  });

  // Delete confirmation modal
  const [deleteOpen, setDeleteOpen] = useState(false);
  const [deleteTarget, setDeleteTarget] = useState<UserRow | null>(null);

  const load = async () => {
    try {
      const { data } = await api.get<UserRow[]>('/master/users');
      setUsers(data);
    } catch {
      toast.error('Erro ao carregar usuários');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, []);

  const create = async () => {
    try {
      await api.post('/master/users', createForm);
      toast.success('Usuário criado!');
      setCreateOpen(false);
      load();
    } catch (err: any) {
      const msg = err?.response?.data?.message;
      toast.error(msg && typeof msg === 'string' ? msg : 'Erro ao criar usuário.');
    }
  };

  const openEdit = (u: UserRow) => {
    setEditTarget(u);
    setEditForm({
      fullName: u.fullName,
      nick: u.nick,
      email: u.email,
      password: '',
      whatsapp: u.whatsapp ?? '',
      city: u.city ?? '',
      state: u.state ?? 'SP',
      role: getRoleName(u.roles?.[0]) ?? 'USER',
      isActive: u.isActive,
      birthDate: (u as any).birthDate ?? '',
    });
    setEditOpen(true);
  };

  const saveEdit = async () => {
    if (!editTarget) return;
    try {
      const payload = { ...editForm } as any;
      if (!payload.password) delete payload.password;
      if (!payload.birthDate) delete payload.birthDate;
      await api.patch(`/master/users/${editTarget.id}`, payload);
      toast.success('Usuário atualizado!');
      setEditOpen(false);
      load();
    } catch (err: any) {
      const msg = err?.response?.data?.message;
      toast.error(msg && typeof msg === 'string' ? msg : 'Erro ao atualizar usuário.');
    }
  };

  const openDelete = (u: UserRow) => {
    setDeleteTarget(u);
    setDeleteOpen(true);
  };

  const confirmDelete = async () => {
    if (!deleteTarget) return;
    const targetRole = getRoleName(deleteTarget.roles?.[0]);
    if (targetRole === 'MASTER') {
      toast.error('Não é possível remover um usuário MASTER.');
      setDeleteOpen(false);
      return;
    }
    if (deleteTarget.id === currentUser?.id) {
      toast.error('Você não pode remover sua própria conta.');
      setDeleteOpen(false);
      return;
    }
    try {
      await api.delete(`/master/users/${deleteTarget.id}`);
      toast.success('Usuário removido!');
      setDeleteOpen(false);
      load();
    } catch {
      toast.error('Erro ao remover usuário.');
    }
  };

  const changeRole = async (u: UserRow, role: RoleName) => {
    try {
      await api.patch(`/master/users/${u.id}/role`, { role });
      toast.success(`Role alterada para ${role}`);
      load();
    } catch {
      toast.error('Erro ao alterar role.');
    }
  };

  const toggleUser = async (u: UserRow) => {
    try {
      await api.patch(`/master/users/${u.id}/toggle`);
      toast.success(u.isActive ? 'Usuário desativado' : 'Usuário ativado');
      load();
    } catch {
      toast.error('Erro ao alterar status.');
    }
  };

  return (
    <div>
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-2xl font-black text-white">👥 Gerenciar Usuários</h1>
        <Button size="sm" onClick={() => setCreateOpen(true)}>
          <Plus size={16} className="mr-1" /> Novo Usuário
        </Button>
      </div>

      {loading ? (
        <div className="flex justify-center py-16"><Spinner /></div>
      ) : (
        <div className="overflow-x-auto rounded-xl border border-[#2d2d2d]">
          <table className="w-full text-sm">
            <thead className="bg-[#0d0d0d]">
              <tr>
                {['Usuário', 'E-mail', 'Cidade', 'Cadastro', 'Status', 'Role', 'Ações'].map((h) => (
                  <th key={h} className="px-4 py-3 text-left text-xs text-[#C8A951] font-bold uppercase">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {users.map((u) => {
                const firstRole = getRoleName(u.roles?.[0]);
                const isSelf = u.id === currentUser?.id;
                const isTargetMaster = firstRole === 'MASTER';
                return (
                  <tr key={u.id} className={`border-t border-[#1a1a1a] hover:bg-[#0d0d0d] ${!u.isActive ? 'opacity-50' : ''}`}>
                    <td className="px-4 py-3">
                      <div className="flex items-center gap-2">
                        <Avatar src={u.avatarUrl} name={u.nick} size="sm" />
                        <div>
                          <p className="text-white font-medium">{u.nick}</p>
                          <p className="text-xs text-gray-500">{u.fullName}</p>
                        </div>
                      </div>
                    </td>
                    <td className="px-4 py-3 text-gray-400">{u.email}</td>
                    <td className="px-4 py-3 text-gray-400">{u.city ?? '-'} {u.state ? `- ${u.state}` : ''}</td>
                    <td className="px-4 py-3 text-gray-400">{formatDate(u.createdAt)}</td>
                    <td className="px-4 py-3">
                      <Badge variant={u.isActive ? 'gold' : 'gray'}>
                        {u.isActive ? 'Ativo' : 'Inativo'}
                      </Badge>
                    </td>
                    <td className="px-4 py-3">
                      {firstRole && (
                        <Badge variant={roleBadge[firstRole] ?? 'gray'}>{firstRole}</Badge>
                      )}
                    </td>
                    <td className="px-4 py-3">
                      <div className="flex items-center gap-2">
                        {/* Edit */}
                        <button
                          onClick={() => openEdit(u)}
                          className="text-xs px-2 py-1 rounded bg-[#2d2d2d] text-gray-300 hover:text-white hover:bg-[#3d3d3d]"
                          title="Editar usuário"
                        >
                          <Pencil size={14} />
                        </button>

                        {/* Role change dropdown (not for MASTER) */}
                        {!isTargetMaster && (
                          <DropdownMenu.Root>
                            <DropdownMenu.Trigger asChild>
                              <button className="text-xs px-2 py-1 rounded bg-[#2d2d2d] text-gray-300 hover:text-white hover:bg-[#3d3d3d]">
                                Role ▾
                              </button>
                            </DropdownMenu.Trigger>
                            <DropdownMenu.Portal>
                              <DropdownMenu.Content className="z-50 rounded-lg border border-[#2d2d2d] bg-[#1a1a1a] p-1 shadow-xl min-w-28">
                                {ROLES.filter(r => r !== 'MASTER').map((r) => (
                                  <DropdownMenu.Item
                                    key={r}
                                    onSelect={() => changeRole(u, r)}
                                    className={`rounded-md px-3 py-2 text-sm cursor-pointer transition-colors ${r === firstRole ? 'text-[#C8A951]' : 'text-gray-300 hover:bg-[#2d2d2d] hover:text-white'}`}
                                  >
                                    {r}
                                  </DropdownMenu.Item>
                                ))}
                              </DropdownMenu.Content>
                            </DropdownMenu.Portal>
                          </DropdownMenu.Root>
                        )}

                        {/* Toggle active (not for MASTER) */}
                        {!isTargetMaster && (
                          <button
                            onClick={() => toggleUser(u)}
                            className="text-xs px-2 py-1 rounded bg-[#2d2d2d] text-gray-300 hover:text-white hover:bg-[#3d3d3d]"
                            title={u.isActive ? 'Desativar' : 'Ativar'}
                          >
                            {u.isActive ? <UserX size={14} /> : <UserCheck size={14} />}
                          </button>
                        )}

                        {/* Delete (only for isMaster, not self, not other MASTER) */}
                        {isMaster && !isSelf && !isTargetMaster && (
                          <button
                            onClick={() => openDelete(u)}
                            className="text-xs px-2 py-1 rounded bg-red-900/40 text-red-400 hover:text-red-200 hover:bg-red-900/60"
                            title="Remover usuário"
                          >
                            <Trash2 size={14} />
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {users.length === 0 && (
            <p className="text-center text-gray-500 py-10">Nenhum usuário encontrado.</p>
          )}
        </div>
      )}

      {/* Create modal */}
      <Modal open={createOpen} onOpenChange={setCreateOpen} title="Criar Usuário">
        <form onSubmit={(e) => { e.preventDefault(); create(); }}>
        <div className="flex flex-col gap-3">
          <Input label="Nome Completo" value={createForm.fullName} onChange={(e) => setCreateForm((f) => ({ ...f, fullName: e.target.value }))} />
          <Input label="Nick" value={createForm.nick} onChange={(e) => setCreateForm((f) => ({ ...f, nick: e.target.value }))} />
          <Input label="E-mail" type="email" value={createForm.email} onChange={(e) => setCreateForm((f) => ({ ...f, email: e.target.value }))} />
          <Input label="Senha" type="password" value={createForm.password} onChange={(e) => setCreateForm((f) => ({ ...f, password: e.target.value }))} />
          <Input label="WhatsApp" value={createForm.whatsapp} onChange={(e) => setCreateForm((f) => ({ ...f, whatsapp: e.target.value }))} />
          <div className="grid grid-cols-2 gap-3">
            <Input label="Cidade" value={createForm.city} onChange={(e) => setCreateForm((f) => ({ ...f, city: e.target.value }))} />
            <div className="flex flex-col gap-1">
              <label className="text-sm font-medium text-gray-300">Estado</label>
              <select className="h-10 rounded-md border border-[#3d3d3d] bg-[#1a1a1a] px-3 text-sm text-white focus:border-[#C8A951] focus:outline-none"
                value={createForm.state} onChange={(e) => setCreateForm((f) => ({ ...f, state: e.target.value }))}>
                {UF_LIST.map((uf) => <option key={uf} value={uf}>{uf}</option>)}
              </select>
            </div>
          </div>
          <div className="flex flex-col gap-1">
            <label className="text-sm font-medium text-gray-300">Role</label>
            <select className="h-10 rounded-md border border-[#3d3d3d] bg-[#1a1a1a] px-3 text-sm text-white focus:border-[#C8A951] focus:outline-none"
              value={createForm.role} onChange={(e) => setCreateForm((f) => ({ ...f, role: e.target.value as RoleName }))}>
              {ROLES.filter(r => r !== 'MASTER').map((r) => <option key={r} value={r}>{r}</option>)}
            </select>
          </div>
          <div className="flex gap-2 mt-2">
            <Button onClick={create} className="flex-1">Criar Usuário</Button>
            <Button variant="ghost" onClick={() => setCreateOpen(false)} className="flex-1">Cancelar</Button>
          </div>
        </div>
        </form>
      </Modal>

      {/* Edit modal */}
      <Modal open={editOpen} onOpenChange={setEditOpen} title={`Editar: ${editTarget?.nick ?? ''}`}>
        <form onSubmit={(e) => { e.preventDefault(); saveEdit(); }}>
        <div className="flex flex-col gap-3">
          <Input label="Nome Completo" value={editForm.fullName} onChange={(e) => setEditForm((f) => ({ ...f, fullName: e.target.value }))} />
          <Input label="Nick" value={editForm.nick} onChange={(e) => setEditForm((f) => ({ ...f, nick: e.target.value }))} />
          <Input label="E-mail" type="email" value={editForm.email} onChange={(e) => setEditForm((f) => ({ ...f, email: e.target.value }))} />
          <Input label="Nova Senha (deixe em branco para manter)" type="password" value={editForm.password} onChange={(e) => setEditForm((f) => ({ ...f, password: e.target.value }))} />
          <BirthDateInput
              label="Data de Nascimento"
              value={editForm.birthDate || ''}
              onChange={(iso) => setEditForm((f) => ({ ...f, birthDate: iso }))}
              maxAge={0}
            />
          <Input label="WhatsApp" value={editForm.whatsapp} onChange={(e) => setEditForm((f) => ({ ...f, whatsapp: e.target.value }))} />
          <div className="grid grid-cols-2 gap-3">
            <Input label="Cidade" value={editForm.city} onChange={(e) => setEditForm((f) => ({ ...f, city: e.target.value }))} />
            <div className="flex flex-col gap-1">
              <label className="text-sm font-medium text-gray-300">Estado</label>
              <select className="h-10 rounded-md border border-[#3d3d3d] bg-[#1a1a1a] px-3 text-sm text-white focus:border-[#C8A951] focus:outline-none"
                value={editForm.state} onChange={(e) => setEditForm((f) => ({ ...f, state: e.target.value }))}>
                {UF_LIST.map((uf) => <option key={uf} value={uf}>{uf}</option>)}
              </select>
            </div>
          </div>
          <div className="flex flex-col gap-1">
            <label className="text-sm font-medium text-gray-300">Role</label>
            <select className="h-10 rounded-md border border-[#3d3d3d] bg-[#1a1a1a] px-3 text-sm text-white focus:border-[#C8A951] focus:outline-none"
              value={editForm.role} onChange={(e) => setEditForm((f) => ({ ...f, role: e.target.value as RoleName }))}>
              {ROLES.filter(r => r !== 'MASTER').map((r) => <option key={r} value={r}>{r}</option>)}
            </select>
          </div>
          <div className="flex items-center gap-3">
            <label className="text-sm font-medium text-gray-300">Ativo</label>
            <button
              type="button"
              onClick={() => setEditForm(f => ({ ...f, isActive: !f.isActive }))}
              className={`relative inline-flex h-6 w-11 rounded-full border-2 transition-colors ${
                editForm.isActive ? 'bg-[#C8A951] border-[#C8A951]' : 'bg-gray-700 border-gray-600'
              }`}
            >
              <span className={`inline-block h-4 w-4 mt-0.5 rounded-full bg-white shadow transform transition-transform ${
                editForm.isActive ? 'translate-x-5' : 'translate-x-0.5'
              }`} />
            </button>
            <span className="text-sm text-gray-400">{editForm.isActive ? 'Sim' : 'Não'}</span>
          </div>
          <div className="flex gap-2 mt-2">
            <Button onClick={saveEdit} className="flex-1">Salvar Alterações</Button>
            <Button variant="ghost" onClick={() => setEditOpen(false)} className="flex-1">Cancelar</Button>
          </div>
        </div>
        </form>
      </Modal>

      {/* Delete confirmation modal */}
      <Modal open={deleteOpen} onOpenChange={setDeleteOpen} title="Confirmar Exclusão">
        <div className="flex flex-col gap-4">
          <p className="text-gray-300">
            Tem certeza que deseja remover o usuário{' '}
            <span className="text-white font-bold">{deleteTarget?.nick}</span>?
          </p>
          <p className="text-sm text-gray-500">Esta ação não pode ser desfeita.</p>
          <div className="flex gap-2">
            <Button variant="danger" onClick={confirmDelete} className="flex-1">
              <Trash2 size={14} className="mr-1" /> Confirmar exclusão
            </Button>
            <Button variant="ghost" onClick={() => setDeleteOpen(false)} className="flex-1">Cancelar</Button>
          </div>
        </div>
      </Modal>
    </div>
  );
}
